<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Benchmarks</RootNamespace>
        <Configurations>Debug;Release;Benchmarks</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
      <PackageReference Include="FluentNHibernate" Version="3.4.1" />
      <PackageReference Include="NHibernate" Version="5.6.0" />
      <PackageReference Include="NHibernate.Driver.MySqlConnector" Version="2.0.5" />
      <PackageReference Include="Remotion.Linq" Version="2.2.0" />
      <PackageReference Include="Antlr3.Runtime" Version="3.5.1" />
      <PackageReference Include="Iesi.Collections" Version="4.1.1" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shoko.Server\Shoko.Server.csproj" />
      <ProjectReference Include="..\Shoko.TestData\Shoko.TestData.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="FluentNHibernate">
        <HintPath>$(NuGetPackageRoot)fluentnhibernate/3.4.1/lib/netstandard2.0/FluentNHibernate.dll</HintPath>
      </Reference>
      <Reference Include="NHibernate">
        <HintPath>$(NuGetPackageRoot)nhibernate/5.6.0/lib/netstandard2.0/NHibernate.dll</HintPath>
      </Reference>
      <Reference Include="NHibernate.Driver.MySqlConnector">
        <HintPath>$(NuGetPackageRoot)nhibernate.driver.mysqlconnector/2.0.5/lib/netstandard2.0/NHibernate.Driver.MySqlConnector.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
